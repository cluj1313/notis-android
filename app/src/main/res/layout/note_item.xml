<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="40dp" android:orientation="horizontal" android:gravity="center_vertical">
    <LinearLayout android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:orientation="vertical">
        <TextView android:id="@+id/ni_text" android:layout_width="match_parent" android:layout_height="wrap_content" android:paddingStart="4dp" android:paddingTop="8dp" android:paddingBottom="8dp" android:textColor="@color/wtxt" android:textSize="15sp" android:maxLines="1" android:ellipsize="end" />
        <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content" android:orientation="horizontal">
            <TextView android:id="@+id/ni_edit" android:layout_width="wrap_content" android:layout_height="wrap_content" android:minHeight="32dp" android:gravity="center_vertical" android:paddingStart="4dp" android:paddingEnd="16dp" android:paddingBottom="6dp" android:textSize="13sp" android:text="@string/edit_btn" android:visibility="gone" />
            <TextView android:id="@+id/ni_del" android:layout_width="wrap_content" android:layout_height="wrap_content" android:minHeight="32dp" android:gravity="center_vertical" android:paddingStart="4dp" android:paddingEnd="12dp" android:paddingBottom="6dp" android:textSize="13sp" android:text="@string/trash_btn" android:visibility="gone" />
        </LinearLayout>
    </LinearLayout>
    <TextView android:id="@+id/ni_no" android:layout_width="wrap_content" android:layout_height="34dp" android:gravity="center" android:paddingStart="12dp" android:paddingEnd="12dp" android:textSize="14sp" android:textStyle="bold" android:text="@string/no" android:visibility="gone" />
    <TextView android:id="@+id/ni_yes" android:layout_width="wrap_content" android:layout_height="34dp" android:gravity="center" android:paddingStart="12dp" android:paddingEnd="12dp" android:layout_marginEnd="2dp" android:textSize="14sp" android:textStyle="bold" android:text="@string/yes" android:visibility="gone" />
    <LinearLayout android:id="@+id/ni_al" android:layout_width="wrap_content" android:layout_height="match_parent" android:minWidth="40dp" android:orientation="vertical" android:gravity="center" android:paddingStart="6dp" android:paddingEnd="2dp">
        <ImageView android:id="@+id/ni_ic" android:layout_width="20dp" android:layout_height="20dp" android:src="@drawable/ic_alarm" android:contentDescription="@string/cd_alarm" />
        <TextView android:id="@+id/ni_time" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textSize="12sp" android:textStyle="bold" android:maxLines="1" android:textColor="@color/wmut" android:visibility="gone" />
    </LinearLayout>
</LinearLayout>
