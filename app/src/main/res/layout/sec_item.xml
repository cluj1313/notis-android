<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/si_row" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="30dp" android:orientation="horizontal" android:gravity="center_vertical" android:paddingStart="2dp" android:paddingEnd="2dp">
    <ImageView android:id="@+id/si_box" android:layout_width="18dp" android:layout_height="18dp" android:layout_marginEnd="8dp" android:src="@drawable/ic_box" android:importantForAccessibility="no" />
    <TextView android:id="@+id/si_text" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:textColor="#EAF5EF" android:textSize="14sp" android:maxLines="1" android:ellipsize="end" />
    <TextView android:id="@+id/si_meta" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="8dp" android:textColor="#9FBFB2" android:textSize="12sp" android:maxLines="1" />
</LinearLayout>
