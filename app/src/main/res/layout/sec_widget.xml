<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/sw_root" android:layout_width="match_parent" android:layout_height="match_parent">
    <ImageView android:id="@+id/sw_bg" android:layout_width="match_parent" android:layout_height="match_parent" android:src="@drawable/w_bg_jad" android:scaleType="fitXY" android:importantForAccessibility="no" />
    <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:padding="10dp">
        <LinearLayout android:id="@+id/sw_head" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical" android:paddingStart="4dp">
            <TextView android:id="@+id/sw_title" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:text="Notis" android:textColor="#8FDCBC" android:textSize="16sp" android:textStyle="bold" android:maxLines="1" android:ellipsize="end" />
            <TextView android:id="@+id/sw_cnt" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textColor="#9FBFB2" android:textSize="12sp" android:maxLines="1" />
            <ImageView android:id="@+id/sw_cfg" android:layout_width="30dp" android:layout_height="30dp" android:layout_marginStart="6dp" android:src="@drawable/ic_gear" android:padding="6dp" android:contentDescription="@string/cd_settings" />
        </LinearLayout>
        <ImageView android:id="@+id/sw_line" android:layout_width="match_parent" android:layout_height="1dp" android:layout_marginTop="6dp" android:layout_marginBottom="2dp" android:src="@drawable/w_line" android:scaleType="fitXY" />
        <FrameLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1">
            <LinearLayout android:id="@+id/sw_rows" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" />
            <TextView android:id="@+id/sw_empty" android:layout_width="match_parent" android:layout_height="match_parent" android:gravity="center" android:padding="8dp" android:textColor="#9FBFB2" android:textSize="13sp" android:visibility="gone" />
        </FrameLayout>
    </LinearLayout>
</FrameLayout>
