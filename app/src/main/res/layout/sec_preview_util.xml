<?xml version="1.0" encoding="utf-8"?>
<!-- Static picker preview only: no ListView (a collection in previewLayout can make the launcher refuse to place the widget). -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent">
    <ImageView android:layout_width="match_parent" android:layout_height="match_parent" android:src="@drawable/w_bg_jad" android:scaleType="fitXY" android:importantForAccessibility="no" />
    <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:padding="10dp">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical" android:paddingStart="4dp">
            <TextView android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:text="@string/h_util" android:textColor="#8FDCBC" android:textSize="16sp" android:textStyle="bold" android:maxLines="1" android:ellipsize="end" />
            <ImageView android:layout_width="30dp" android:layout_height="30dp" android:layout_marginStart="6dp" android:src="@drawable/ic_gear_cog" android:padding="6dp" android:importantForAccessibility="no" />
        </LinearLayout>
        <ImageView android:layout_width="match_parent" android:layout_height="1dp" android:layout_marginTop="6dp" android:layout_marginBottom="2dp" android:src="@drawable/w_line" android:scaleType="fitXY" />
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:paddingStart="4dp" android:paddingTop="8dp" android:text="—" android:textColor="#EAF5EF" android:textSize="14sp" android:maxLines="1" android:ellipsize="end" />
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:paddingStart="4dp" android:paddingTop="8dp" android:text="—" android:textColor="#9FBFB2" android:textSize="14sp" android:maxLines="1" android:ellipsize="end" />
    </LinearLayout>
</FrameLayout>
